{
  "name": "ledgerflow-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop-first software company operating system for a solo LedgerFlow owner.",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "ai:doctor": "node scripts/ai-doctor.mjs",
    "prepare:icons": "node scripts/prepare-desktop-icons.mjs",
    "check:simulations": "node scripts/check-simulation-modules.mjs",
    "check:founder-labs": "node scripts/check-founder-labs.mjs",
    "check:accounting-calculations": "node scripts/check-accounting-calculations.mjs",
    "check:agentops-contracts": "node scripts/check-agentops-contracts.mjs",
    "check:new-features-brief": "node scripts/check-new-features-brief.mjs",
    "check:company-os": "npm run lint && npm run check:agentops-contracts",
    "migrate:accounting-calculations": "node scripts/migrate-accounting-calculations.mjs",
    "check:build": "node scripts/check-build-output.mjs",
    "check:desktop": "node scripts/check-desktop-package.mjs",
    "check:runtime": "node scripts/check-runtime-api.mjs",
    "check:offline": "node scripts/check-offline-readiness.mjs",
    "check:offline-vendor-assets": "node scripts/check-offline-vendor-assets.mjs",
    "check:release": "node scripts/check-release-artifacts.mjs",
    "check:env": "node scripts/check-env-config.mjs",
    "check:desktop-release": "node scripts/check-hybrid-release.mjs",
    "check:desktop-release:full": "node scripts/check-hybrid-release.mjs --release",
    "check:hybrid": "npm run check:desktop-release",
    "check:hybrid:release": "npm run check:desktop-release:full",
    "doctor": "node scripts/doctor.mjs",
    "doctor:write": "node scripts/doctor.mjs --write",
    "build:manifest": "node scripts/write-build-manifest.mjs",
    "release:notes": "node scripts/write-release-notes.mjs",
    "prebuild": "npm run prepare:icons && npm run check:env && npm run check:simulations && npm run check:founder-labs && npm run check:accounting-calculations && npm run check:agentops-contracts && npm run check:desktop && npm run check:offline",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "postbuild": "npm run build:manifest && npm run check:build",
    "start": "node dist/server.cjs",
    "desktop:dev": "npm run build && npm run prepare:icons && cross-env NODE_ENV=production ELECTRON_DESKTOP=true electron desktop/main.cjs",
    "desktop:pack": "npm run build && npm run prepare:icons && electron-builder --dir && npm run release:notes",
    "desktop:dist": "npm run build && npm run prepare:icons && electron-builder && npm run release:notes",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "assistant:start": "tsx server/assistant-daemon.ts",
    "assistant:cli": "tsx scripts/ai-assistant-cli.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.107.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "puppeteer": "^25.1.0",
    "simple-git": "^3.36.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "commander": "^13.1.0",
    "cross-env": "^7.0.3",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "com.ledgerflow.hub",
    "productName": "LedgerFlow Hub",
    "artifactName": "LedgerFlow-Hub-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "build/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "LedgerFlow Hub",
      "uninstallDisplayName": "LedgerFlow Hub",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
