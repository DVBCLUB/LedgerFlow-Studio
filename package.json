{
  "name": "ledgerflow-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Hybrid learning, business and research studio built from Google AI Studio.",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "web:dev": "tsx server.ts",
    "prepare:icons": "node scripts/prepare-desktop-icons.mjs",
    "check:simulations": "node scripts/check-simulation-modules.mjs",
    "check:founder-labs": "node scripts/check-founder-labs.mjs",
    "check:accounting-calculations": "node scripts/check-accounting-calculations.mjs",
    "migrate:accounting-calculations": "node scripts/migrate-accounting-calculations.mjs",
    "check:build": "node scripts/check-build-output.mjs",
    "check:desktop": "node scripts/check-desktop-package.mjs",
    "check:runtime": "node scripts/check-runtime-api.mjs",
    "check:offline": "node scripts/check-offline-readiness.mjs",
    "check:release": "node scripts/check-release-artifacts.mjs",
    "check:env": "node scripts/check-env-config.mjs",
    "check:hybrid": "node scripts/check-hybrid-release.mjs",
    "check:hybrid:release": "node scripts/check-hybrid-release.mjs --release",
    "doctor": "node scripts/doctor.mjs",
    "doctor:write": "node scripts/doctor.mjs --write",
    "build:manifest": "node scripts/write-build-manifest.mjs",
    "release:notes": "node scripts/write-release-notes.mjs",
    "prebuild": "npm run prepare:icons && npm run check:env && npm run check:simulations && npm run check:founder-labs && npm run check:accounting-calculations && npm run check:desktop && npm run check:offline",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "postbuild": "npm run build:manifest && npm run check:build",
    "web:build": "npm run build",
    "start": "node dist/server.cjs",
    "web:start": "node dist/server.cjs",
    "desktop:dev": "npm run build && cross-env NODE_ENV=production ELECTRON_DESKTOP=true electron desktop/main.cjs",
    "desktop:pack": "npm run build && electron-builder --dir && npm run release:notes",
    "desktop:dist": "npm run build && electron-builder && npm run release:notes",
    "preview": "vite preview",
    "clean": "rm -rf dist release build server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.ledgerflow.hub",
    "productName": "LedgerFlow Hub",
    "artifactName": "LedgerFlow-Hub-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "build/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "LedgerFlow Hub",
      "uninstallDisplayName": "LedgerFlow Hub"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
