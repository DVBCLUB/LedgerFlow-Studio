# ============================================================
# AI Coding Assistant — Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ── Telegram Bot ─────────────────────────────────────────────
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of allowed Telegram user IDs (security whitelist)
# Get your user ID by messaging @userinfobot on Telegram
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# Polling or webhook mode. Use "polling" for local dev, "webhook" for production.
TELEGRAM_MODE=polling

# ── Assistant Daemon ─────────────────────────────────────────
# Port for the assistant daemon (separate from LedgerFlow main app on 3000)
ASSISTANT_PORT=3001

# Optional runtime directory for local JSON/log/vault files.
# Default is runtime
LEDGERFLOW_RUNTIME_DIR=runtime

# Absolute path to the workspace root — all file access is sandboxed here
# Windows example: D:\CODE\LedgerFlow-Studio
# Linux/Mac example: /home/user/projects/my-project
ASSISTANT_WORKSPACE=D:\CODE\LedgerFlow-Studio

# ── File Safety ──────────────────────────────────────────────
# Maximum file size the AI can read (in KB). Default: 500
MAX_FILE_SIZE_KB=500

# Default backup strategy: "auto" uses a local file copy; Git commits require explicit opt-in.
BACKUP_STRATEGY=auto

# ── AI Router (already configured via LedgerFlow AI Settings UI) ──
# These are auto-managed by the LedgerFlow AI Key Vault.
# You don't need to set them manually if you use the Settings UI.
# AI_VAULT_SECRET=  (auto-generated on first run)

# Optional: LiteLLM proxy fallback (if you run a local LiteLLM server)
# AI_PROXY_URL=http://127.0.0.1:4000
# AI_PROXY_KEY=sk-ledgerflow-local-2026
