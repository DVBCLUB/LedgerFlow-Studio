# LedgerFlow Hub environment example
# Copy this file to .env.local for local development or configure secrets on your hosting platform.

# AI Key Manager mode (recommended): users add Gemini/Groq/OpenRouter/Claude/Ollama credentials
# directly inside the app at /ai-settings.html. They are encrypted into ai_keys.vault.json.
# Optional: set a custom vault secret if you want to control encryption key derivation.
AI_VAULT_SECRET=

# Optional compatibility fallback: LiteLLM proxy.
# Only used when the local encrypted AI Key Vault has no enabled provider credentials.
AI_PROXY_URL=http://127.0.0.1:4000
AI_PROXY_KEY=sk-ledgerflow-local-2026

# Legacy Gemini variables are no longer required by server.ts.
# Keep them only if older branches or external tooling still read them.
GEMINI_API_KEY=
PMSTUDY=

# Optional Supabase project settings.
# Local offline database still works without Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional public app URL for web deployments.
APP_URL=

# Optional explicit server port for web hosting.
# Desktop currently uses 3000 internally.
PORT=3000

# Required for hosted production. Desktop/local development may use the visible
# admin123 fallback until the owner configures a private password.
LOCAL_AUTH_DEV_PASSWORD=

# Optional bearer token for trusted n8n/webhook/service clients that cannot use
# the browser session cookie. Keep this secret server-side.
LEDGERFLOW_API_TOKEN=

# Runtime mode notes:
# - Offline/local UI and local database: no provider credential required.
# - Live AI generation: configure providers at /ai-settings.html or run LiteLLM proxy.
# - ai_keys.vault.json and .ledgerflow_secret are intentionally ignored by git.
